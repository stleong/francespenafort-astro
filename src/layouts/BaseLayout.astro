---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "ICF-accredited Level 1 coach certification in Kuala Lumpur by Dr Frances Penafort, MCC." 
} = Astro.props;
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Frances' Coaching School</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-sand-100 text-charcoal-900 font-sans antialiased selection:bg-navy-900 selection:text-white">
    
    <!-- Smart Auto-Hiding Sticky Header -->
    <header 
      id="main-header" 
      class="border-b border-sand-200 bg-sand-100/95 backdrop-blur-md sticky top-0 z-50 transition-transform duration-300 ease-in-out"
    >
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between gap-6">
        
        <!-- Brand Logo -->
        <a href="/" class="font-serif text-lg sm:text-xl font-bold text-navy-900 tracking-tight whitespace-nowrap shrink-0">
          Frances’ Coaching School
        </a>

        <!-- Desktop Navigation & CTA Group -->
        <div class="hidden lg:flex items-center space-x-6 shrink-0">
          
          <!-- Compact Navigation Links -->
          <nav class="flex items-center space-x-6 text-sm font-medium text-charcoal-900 whitespace-nowrap">
            <a href="/" class="hover:text-navy-900 transition">Home</a>
            <a href="/about-frances" class="hover:text-navy-900 transition">About</a>
            <a href="/icf-level-1-acc-certification-kuala-lumpur" class="hover:text-navy-900 transition">Level 1 Certification</a>
            <a href="/coaching-and-supervision" class="hover:text-navy-900 transition">Supervision</a>
            <a href="/icf-level-1-or-portfolio-path" class="hover:text-navy-900 transition">Accreditation</a>
            <a href="/faq" class="hover:text-navy-900 transition">FAQ</a>
          </nav>

          <!-- Divider & CTA Button -->
          <div class="flex items-center pl-4 border-l border-sand-200">
            <a href="/attend-a-preview" class="inline-block px-5 py-2.5 bg-navy-900 hover:bg-navy-800 text-sand-50 text-sm font-medium rounded-full shadow-xs whitespace-nowrap transition">
              Attend Preview
            </a>
          </div>

        </div>

        <!-- Mobile Hamburger Toggle Button -->
        <div class="flex items-center lg:hidden">
          <button 
            id="mobile-menu-btn" 
            type="button" 
            aria-label="Toggle navigation menu"
            class="p-2 text-navy-900 hover:text-navy-800 focus:outline-none"
          >
            <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>

      <!-- Mobile Dropdown Menu -->
      <div 
        id="mobile-menu" 
        class="hidden lg:hidden border-t border-sand-200 bg-sand-50 px-6 py-6 space-y-4 shadow-lg"
      >
        <nav class="flex flex-col space-y-3.5 text-base font-medium text-charcoal-900">
          <a href="/" class="hover:text-navy-900 py-1 transition">Home</a>
          <a href="/about-frances" class="hover:text-navy-900 py-1 transition">About</a>
          <a href="/icf-level-1-acc-certification-kuala-lumpur" class="hover:text-navy-900 py-1 transition">Level 1 Certification</a>
          <a href="/coaching-and-supervision" class="hover:text-navy-900 py-1 transition">Supervision</a>
          <a href="/icf-level-1-or-portfolio-path" class="hover:text-navy-900 py-1 transition">Accreditation</a>
          <a href="/faq" class="hover:text-navy-900 py-1 transition">FAQ</a>
        </nav>
        <div class="pt-4 border-t border-sand-200">
          <a href="/attend-a-preview" class="block w-full text-center px-5 py-3 bg-navy-900 hover:bg-navy-800 text-sand-50 font-medium text-sm rounded-full transition">
            Attend Preview
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-navy-900 text-sand-100 mt-24 border-t border-navy-800">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          
          <!-- Column 1: School Identity & Credentials -->
          <div class="md:col-span-1">
            <h3 class="font-serif text-lg font-bold text-sand-50 mb-3">Frances’ Coaching School</h3>
            <p class="text-sm text-sand-200/80 leading-relaxed mb-4">
              GPS Professionals Sdn Bhd<br />
              Kuala Lumpur, Malaysia
            </p>
            <p class="text-xs text-sand-200/60 leading-relaxed">
              First and only woman MCC in Malaysia with an ICF-accredited coaching school.
            </p>
          </div>

          <!-- Column 2: Quick Links -->
          <div>
            <h4 class="text-xs font-semibold text-sand-200 uppercase tracking-wider mb-4">Curriculum</h4>
            <ul class="space-y-2.5 text-sm text-sand-200/80">
              <li><a href="/icf-level-1-acc-certification-kuala-lumpur" class="hover:text-sand-50 transition">Level 1 Certification</a></li>
              <li><a href="/icf-level-1-or-portfolio-path" class="hover:text-sand-50 transition">Is it accredited?</a></li>
              <li><a href="/coaching-and-supervision" class="hover:text-sand-50 transition">Coaching & Supervision</a></li>
              <li><a href="https://coachingfederation.org/ethics/code-of-ethics" target="_blank" rel="noopener noreferrer" class="hover:text-sand-50 transition">ICF Code of Ethics ↗</a></li>
            </ul>
          </div>

          <!-- Column 3: Contact & Enquiries -->
          <div>
            <h4 class="text-xs font-semibold text-sand-200 uppercase tracking-wider mb-4">Enquiries</h4>
            <ul class="space-y-2 text-sm text-sand-200/80">
              <li>
                <a href="mailto:frances@francespenafort.com" class="hover:text-sand-50 transition">
                  frances@francespenafort.com
                </a>
              </li>
              <li>
                <a href="tel:+60123951912" class="hover:text-sand-50 transition">
                  +60 12-395 1912
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 4: Connect & Social Media Channels -->
          <div>
            <h4 class="text-xs font-semibold text-sand-200 uppercase tracking-wider mb-4">Connect</h4>
            <p class="text-xs text-sand-200/70 mb-4 leading-relaxed">
              Connect with Dr Frances Penafort and Frances’ Coaching School:
            </p>
            
            <div class="flex items-center gap-3">
              <!-- LinkedIn -->
              <a 
                href="https://www.linkedin.com/in/francespenafort/" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Dr Frances Penafort on LinkedIn"
                class="w-9 h-9 rounded-full bg-navy-800 hover:bg-navy-700 hover:text-white text-sand-200 flex items-center justify-center transition border border-white/5"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>

                <!-- WhatsApp Direct Direct Connect -->
              <a 
                href="https://wa.me/60123951912" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Chat on WhatsApp"
                class="w-9 h-9 rounded-full bg-navy-800 hover:bg-navy-700 hover:text-white text-sand-200 flex items-center justify-center transition border border-white/5"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </a>

              <!-- Facebook -->
              <a 
                href="https://www.facebook.com/drfrancespenafort" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Facebook Page"
                class="w-9 h-9 rounded-full bg-navy-800 hover:bg-navy-700 hover:text-white text-sand-200 flex items-center justify-center transition border border-white/5"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            </div>
          </div>

        </div>

        <!-- Copyright & Compliance Sub-Footer -->
        <div class="pt-8 border-t border-navy-800/80 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-sand-200/60">
          <p>© {new Date().getFullYear()} GPS Professionals Sdn Bhd. All rights reserved.</p>
          <div class="flex space-x-6">
            <a href="/privacy-policy" class="hover:text-sand-50 transition">Privacy Policy</a>
            <a href="/cookies-policy" class="hover:text-sand-50 transition">Cookies Policy</a>
            <a href="/pdpa-notice" class="hover:text-sand-50 transition">PDPA Notice</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Header & Mobile Drawer Scripts -->
    <script>
      let lastScrollY = window.scrollY;
      const header = document.getElementById('main-header');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      // 1. Mobile Menu Toggle
      mobileBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.toggle('hidden');
        if (isHidden) {
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      // 2. Hide on Scroll Down, Show on Scroll Up
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        
        // Don't hide if the mobile menu drawer is currently open
        const isMenuOpen = mobileMenu && !mobileMenu.classList.contains('hidden');
        
        if (!isMenuOpen) {
          if (currentScrollY > lastScrollY && currentScrollY > 100) {
            // Scrolling down -> slide out of view
            header?.classList.add('-translate-y-full');
          } else {
            // Scrolling up -> slide back in
            header?.classList.remove('-translate-y-full');
          }
        }
        lastScrollY = currentScrollY;
      });
    </script>
  </body>
</html>