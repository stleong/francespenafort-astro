---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedStatement from '../components/AnimatedStatement.astro';
---

<BaseLayout title="ICF Level 1 Coach Certification Kuala Lumpur">

  <!-- Block 1: Modern Split Hero Section -->
  <section class="relative overflow-hidden bg-sand-50 border-b border-sand-200">
    <div class="max-w-7xl mx-auto px-6 py-12 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Content Column -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          
          <!-- Top Credential & Dual-Logo Bar -->
          <div class="flex items-center gap-6 mb-8 pb-6 border-b border-sand-200/80">
            <span class="font-serif text-lg font-bold tracking-tight text-navy-900">
              Frances’ Coaching School
            </span>
            <div class="h-6 w-px bg-sand-200"></div>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 bg-navy-900 text-sand-50 text-[11px] font-bold tracking-wider rounded uppercase">
                ICF Level 1
              </span>
              <span class="text-xs font-semibold text-charcoal-900/70 uppercase tracking-wider">
                Accredited Education
              </span>
            </div>
          </div>

          <!-- Upcoming Cohort Tag -->
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-bronze-600 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-bronze-600">
              2027 Intakes — January
            </span>
          </div>

          <!-- Main Headline -->
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-navy-900 leading-[1.15] mb-6">
            ICF Level 1 <span class="text-bronze-600">coaching certification.</span>
          </h1>

          <!-- Body Copy -->
          <p class="text-base sm:text-lg text-charcoal-900 leading-relaxed mb-6 max-w-2xl">
            Sixty hours of coach-specific education, Ten hours of mentor coaching.
          </p>
          
          <!-- Primary Single CTA Button -->
          <div class="mb-8">
            <a 
              href="/attend-a-preview" 
              class="inline-flex items-center justify-center px-8 py-4 bg-charcoal-900 hover:bg-navy-900 text-sand-50 font-medium text-sm sm:text-base rounded-full shadow-sm hover:shadow transition duration-200"
            >
              Attend the FREE preview
            </a>
          </div>

          <!-- Bottom Trust & Pricing Matrix Strip -->
          <div class="pt-6 border-t border-sand-200/80 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-charcoal-900/80">
            <div>
              <span class="font-bold text-navy-900 block mb-0.5">Current Cohort Dates:</span>
              14–15 Aug, 11–12 Sept, 9–10 Oct 2026
            </div>
            <div>
              <span class="font-bold text-navy-900 block mb-0.5">Next Cohort Dates:</span>
              29-30 Jan, 26-27 Feb, 2-3 April 2027
            </div>
          </div>

        </div>

        <!-- Right Visual Column (Modern Edge-Rounded Cohort Card) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden border border-sand-200 shadow-md aspect-[4/5] bg-sand-200">
            <img 
              src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80" 
              alt="Coaching cohort participating in live triads in Kuala Lumpur" 
              class="w-full h-full object-cover"
            />                        
          </div>
        </div>

      </div>
    </div>
  </section>
  
    <!-- Fluid Animated Statement Banner -->
  		<AnimatedStatement 
   	 	title="Frances’ Coaching School"
    	statement="Cohorts are capped at about ten, every session is observed, and every student gets written feedback. That is why the number is small, and it is why we publish it. Ask any school for theirs."
  	/>



  <!-- Who Is This Programme For Section -->
  <section class="py-16 md:py-24 bg-sand-100/50 border-t border-sand-200">
    <div class="max-w-6xl mx-auto px-6">
      
      <!-- Section Header -->
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-bronze-600 block mb-2">
          Audience & Fit
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-900 leading-tight mb-4">
          Who is this programme for?
        </h2>
        <p class="text-base sm:text-lg text-charcoal-900/80 leading-relaxed">
          Whether you are new to coaching, already supporting others, or exploring your next career, there is a place for you here.
        </p>
      </div>

      <!-- 3-Column Profile Cards with Images -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        
        <!-- Profile 1: Leaders & Managers -->
        <div class="bg-sand-50 rounded-2xl border border-sand-200 overflow-hidden flex flex-col justify-between shadow-2xs group hover:border-navy-900/40 transition duration-300">
          <div>
            <!-- Image Wrapper (AdobeStock_445078230.jpeg) -->
            <div class="aspect-[16/10] w-full overflow-hidden bg-sand-200/50">
              <img 
                src="/images/audience/leaders-and-managers.jpeg" 
                alt="Leaders and managers in an organisation"
                class="w-full h-full object-cover object-center group-hover:scale-102 transition duration-500"
                loading="lazy"
              />
            </div>

            <!-- Content Area -->
            <div class="p-6 sm:p-7">
              <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-navy-900 text-sand-50 font-serif font-bold text-xs mb-4">
                01
              </div>
              <h3 class="font-serif text-xl font-bold text-navy-900 mb-2 leading-snug">
                Leaders & Managers
              </h3>
              <p class="text-sm text-charcoal-900/80 leading-relaxed">
                You lead people and want to bring out their best. Learn to listen more deeply, have meaningful conversations, and help your team grow.
              </p>
            </div>
          </div>
        </div>

        <!-- Profile 2: Aspiring & Practising Coaches -->
        <div class="bg-sand-50 rounded-2xl border border-sand-200 overflow-hidden flex flex-col justify-between shadow-2xs group hover:border-navy-900/40 transition duration-300">
          <div>
            <!-- Image Wrapper (AdobeStock_208777716.jpeg) -->
            <div class="aspect-[16/10] w-full overflow-hidden bg-sand-200/50">
              <img 
                src="/images/audience/aspiring-coaches.jpeg" 
                alt="1-on-1 coaching session in progress"
                class="w-full h-full object-cover object-center group-hover:scale-102 transition duration-500"
                loading="lazy"
              />
            </div>

            <!-- Content Area -->
            <div class="p-6 sm:p-7">
              <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-navy-900 text-sand-50 font-serif font-bold text-xs mb-4">
                02
              </div>
              <h3 class="font-serif text-xl font-bold text-navy-900 mb-2 leading-snug">
                Aspiring & Practising Coaches
              </h3>
              <p class="text-sm text-charcoal-900/80 leading-relaxed">
                You want to become a professional coach or strengthen your existing coaching skills, with a clear pathway towards an internationally recognised ICF credential.
              </p>
            </div>
          </div>
        </div>

        <!-- Profile 3: Career Changers & Professionals -->
        <div class="bg-sand-50 rounded-2xl border border-sand-200 overflow-hidden flex flex-col justify-between shadow-2xs group hover:border-navy-900/40 transition duration-300">
          <div>
            <!-- Image Wrapper (AdobeStock_384489279.jpeg) -->
            <div class="aspect-[16/10] w-full overflow-hidden bg-sand-200/50">
              <img 
                src="/images/audience/career-changers.jpeg" 
                alt="Senior professional considering career transition into coaching"
                class="w-full h-full object-cover object-top group-hover:scale-102 transition duration-500"
                loading="lazy"
              />
            </div>

            <!-- Content Area -->
            <div class="p-6 sm:p-7">
              <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-navy-900 text-sand-50 font-serif font-bold text-xs mb-4">
                03
              </div>
              <h3 class="font-serif text-xl font-bold text-navy-900 mb-2 leading-snug">
                Career Changers & Professionals
              </h3>
              <p class="text-sm text-charcoal-900/80 leading-relaxed">
                You are ready for a new chapter. Turn your professional and life experience into meaningful work by helping others discover their potential.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Suggested Closing Line Banner -->
      <div class="p-6 sm:p-8 bg-sand-50 rounded-2xl border border-sand-200 text-center shadow-2xs">
        <p class="font-serif italic text-base sm:text-lg text-navy-900 leading-relaxed max-w-2xl mx-auto">
          “No previous coaching experience required. Just the willingness to learn, grow, and make a difference.”
        </p>
      </div>

    </div>
  </section>

{/*
  <!-- Block 3: Accredited, not aligned -->
  <section class="py-20 max-w-4xl mx-auto px-6">
    <div class="p-8 md:p-12 bg-sand-50 border border-sand-200 rounded-lg">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy-900 mb-4">Accredited, not aligned.</h2>
      <p class="text-base leading-relaxed text-charcoal-900 mb-4">
        Frances’ Coaching School holds ICF Level 1 accreditation. That has one practical consequence for you: when you apply for your ACC, you use ICF’s Level 1 path reviewed in about four weeks.
      </p>
      <p class="text-base leading-relaxed text-charcoal-900 mb-4">
        Coaches who train with a programme ICF has not accredited apply through the Portfolio path instead. reviewed in about fourteen weeks.
      </p>
      <p class="text-base leading-relaxed text-charcoal-900 mb-6">
        Same credential. Different route to it. Ask any school you are considering which one you will be using.
      </p>
      <a href="/icf-level-1-or-portfolio-path" class="text-navy-900 font-semibold underline underline-offset-4 hover:text-navy-800 transition">
        The difference explained in full &rarr;
      </a>
    </div>
  </section>
*/}

  <!-- Instructor Spotlight & Video Introduction -->
  <section class="py-16 md:py-24 bg-sand-50 border-t border-sand-200">
    <div class="max-w-6xl mx-auto px-6">
      
      <!-- Section Headline & Eyebrow -->
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-bronze-600 block mb-2">
          Meet Your Instructor
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-900 leading-tight">
          Learn directly from Malaysia’s first woman MCC.
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Video Player Column (7 Cols) -->
        <div class="lg:col-span-7">
          <div class="relative aspect-video w-full rounded-2xl overflow-hidden border border-sand-300 shadow-md bg-navy-950">
            <video 
              controls
              playsinline
              preload="metadata"
              poster="/images/dr-frances-penafort.jpg"
              class="w-full h-full object-cover"
            >
              <source src="/videos/intro-video.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
          <p class="text-xs text-charcoal-900/60 mt-3 text-center lg:text-left italic">
            Watch Dr. Frances introduce her coaching philosophy, global track record, and the school’s vision.
          </p>
        </div>

        <!-- Bio & Credentials Column (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col justify-center">
          <h3 class="font-serif text-2xl font-bold text-navy-900 mb-2">
            Dr Frances Penafort
          </h3>
          <p class="text-xs font-semibold tracking-wider uppercase text-bronze-600 mb-5">
            MCC (ICF) · Director of Education
          </p>

          <p class="text-sm md:text-base text-charcoal-900 leading-relaxed mb-4">
            Sixteen years coaching C-suite and senior leaders, with clients across sixteen countries in banking, oil and gas, telecommunications, healthcare, FMCG, manufacturing, and higher education.
          </p>
          
          <p class="text-sm text-charcoal-900/80 leading-relaxed mb-6">
            Accredited Coach Supervisor (CSA), first elected President of ICF Malaysia Chapter, and former director across three ICF Global Boards.
          </p>

          <div>
            <a 
              href="/about-frances" 
              class="inline-flex items-center gap-2 text-sm font-bold text-navy-900 hover:text-bronze-600 underline underline-offset-4 transition"
            >
              <span>Read more about Dr Frances</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

 <!-- Block 6: Testimonials Layout & Official Brochure Download -->
  <section class="py-16 bg-sand-200/40 border-t border-sand-200">
    <div class="max-w-5xl mx-auto px-6">
      
      <!-- Section Title -->
      <div class="text-center mb-10">
        <span class="text-xs font-semibold text-navy-900 uppercase tracking-wider block mb-2">Participant Experience</span>
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy-900">Proof, not promises.</h2>
      </div>

      <!-- Real Student Testimonials from Brochure -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        
        <!-- Mohammad H. Azmi -->
        <div class="bg-sand-50 p-6 sm:p-8 rounded-xl border border-sand-200 text-charcoal-900 flex flex-col justify-between shadow-2xs">
          <blockquote class="italic text-sm sm:text-base leading-relaxed mb-6">
            “I can confidently go into any coaching session. I don't need to prepare the perfect question - just by being PRESENT, the powerful questions emerge on its own..”
          </blockquote>
          <div class="pt-4 border-t border-sand-200 not-italic">
            <div class="font-serif font-bold text-navy-900 text-sm">Mohammad H. Azmi</div>
            <div class="text-xs text-charcoal-900/70 mt-0.5">Training and Coaching Practitioner</div>
          </div>
        </div>

        <!-- S. De Costa -->
        <div class="bg-sand-50 p-6 sm:p-8 rounded-xl border border-sand-200 text-charcoal-900 flex flex-col justify-between shadow-2xs">
          <blockquote class="italic text-sm sm:text-base leading-relaxed mb-6">
            “The best thing about FCS is that all students get real coaching clients to coach. We practise with peers in class reviewed by both our instructors and our classmates. You improve real quick with constructive feedback. You cannot beat the experiential learning that you get at FCS”
          </blockquote>
          <div class="pt-4 border-t border-sand-200 not-italic">
            <div class="font-serif font-bold text-navy-900 text-sm">S. De Costa</div>
            <div class="text-xs text-charcoal-900/70 mt-0.5">Legal and Coaching Practitioner</div>
          </div>
        </div>

      </div>

      <!-- Official Brochure Download Card -->
      <div class="p-6 sm:p-8 bg-sand-50 border border-sand-200 rounded-xl shadow-2xs flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-bronze-600 block mb-1">Official Programme Overview</span>
          <h3 class="font-serif text-lg sm:text-xl font-bold text-navy-900 mb-1">
            Download the 2027 ICF Level 1 Brochure
          </h3>
          <p class="text-xs sm:text-sm text-charcoal-900/80 leading-relaxed max-w-xl">
            Complete details on the 60 class hours, 24 client coaching hours, 10 mentor coaching sessions, and upcoming module dates.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a 
            href="/downloads/fcs_2027_brochure.pdf" 
            download="Frances-Coaching-School-2027-Brochure.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-navy-900 hover:bg-navy-800 text-sand-50 text-xs sm:text-sm font-semibold rounded-full shadow-xs transition"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download PDF</span>
          </a>
          <a 
            href="/downloads/fcs_2027_brochure.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-4 py-3 bg-sand-100 hover:bg-sand-200 text-charcoal-900 text-xs sm:text-sm font-medium rounded-full border border-sand-200 transition"
          >
            View in Browser &nearr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Block 7: Close -->
  <section class="py-20 max-w-3xl mx-auto px-6 text-center">
    <p class="text-lg md:text-xl text-charcoal-900 mb-8 leading-relaxed">
      The preview runs on the first Saturday of every month. Sixty minutes, no charge, and you will know by the end whether this is for you.
    </p>
    <a href="/attend-a-preview" class="inline-block px-8 py-4 bg-navy-900 hover:bg-navy-800 text-sand-50 font-semibold text-base rounded shadow-sm transition">
      Register for the FREE preview
    </a>
  </section>


  <!-- Step 9: Verified ICF Accreditation & Credentials Strip -->
<section class="py-16 bg-sand-50 border-y border-sand-200">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Text & Authority Column -->
      <div class="lg:col-span-7">
        <span class="text-xs font-semibold text-navy-900 uppercase tracking-wider block mb-2">
          Verified Credentials & Accreditations
        </span>
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy-900 mb-4">
          ICF-Accredited Level 1 School & Master Certified Coach
        </h2>
        <p class="text-base text-charcoal-900 leading-relaxed mb-4">
          Dr Frances Penafort, MCC, is the Director of Education. Frances’ Coaching School holds ICF Level 1 accreditation, allowing candidates to follow the accelerated Level 1 application route.
        </p>
      </div>

      <!-- Badge Strip (Pixel-Perfect Identical Cards & Badges) -->
      <div class="lg:col-span-5 grid grid-cols-3 gap-4">
        
        <!-- 1. ICF Level 1 School Badge -->
        <div 
          {/* href="https://coachingfederation.org/education-search" target="_blank" rel="noopener noreferrer" */}
          class="flex flex-col items-center justify-between p-5 bg-sand-100/60 rounded-xl border border-sand-200 text-center h-full shadow-2xs"
        >
          <!-- Fixed 72px square badge wrapper -->
          <div class="w-18 h-18 flex items-center justify-center mb-3 shrink-0">
            <img 
              src="/images/badges/icf_level_1.png" 
              alt="ICF Level 1 Accredited Education" 
              class="w-full h-full object-contain p-0.5"
            />
          </div>

          <!-- Title with fixed height so 1-line and 2-line text match -->
          <div class="min-h-[2.5rem] flex items-center justify-center">
            <span class="text-xs font-bold text-navy-900 leading-snug">
              Accredited<br />School
            </span>
          </div>

          <!-- Link label -->
          <span class="text-[11px] text-charcoal-900/60 mt-2">
            Verified School
          </span>
        </div>

        <!-- 2. ICF MCC Badge -->
        <a 
          href="https://apps.coachingfederation.org/eweb/CCFDynamicPage.aspx?webcode=ccfcoachprofileview&coachcstkey=9FD41289-BAF4-482E-9841-EB8DCCBB5C2F"
          target="_blank" 
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-between p-5 bg-sand-100/60 rounded-xl border border-sand-200 text-center hover:border-navy-900 hover:bg-sand-100 transition duration-200 group h-full shadow-2xs"
        >
          <!-- Fixed 72px square badge wrapper -->
          <div class="w-18 h-18 flex items-center justify-center mb-3 shrink-0">
            <img 
              src="/images/badges/mcc_logo.png" 
              alt="ICF Master Certified Coach (MCC)" 
              class="w-full h-full object-contain p-0.5 group-hover:scale-105 transition-transform duration-200"
            />
          </div>

          <!-- Title with fixed height -->
          <div class="min-h-[2.5rem] flex items-center justify-center">
            <span class="text-xs font-bold text-navy-900 leading-snug">
              Master<br />Coach
            </span>
          </div>

          <!-- Link label -->
          <span class="text-[11px] text-charcoal-900/60 group-hover:text-navy-900 transition mt-2">
            Verify Credential &nearr;
          </span>
        </a>

        <!-- 3. CSA Supervisor Badge -->
        <a 
          {/* href="https://www.coachesstatustool.com" */}
          target="_blank" 
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-between p-5 bg-sand-100/60 rounded-xl border border-sand-200 text-center hover:border-navy-900 hover:bg-sand-100 transition duration-200 group h-full shadow-2xs"
        >
          <!-- Fixed 72px square badge wrapper -->
          <div class="w-18 h-18 flex items-center justify-center mb-3 shrink-0">
            <img 
              src="/images/badges/actc_logo.png" 
              alt="CSA Accredited Coach Supervisor" 
              class="w-full h-full object-contain p-0.5 group-hover:scale-105 transition-transform duration-200"
            />
          </div>

          <!-- Title with fixed height -->
          <div class="min-h-[2.5rem] flex items-center justify-center">
            <span class="text-xs font-bold text-navy-900 leading-snug">
              Coach<br />Supervisor
            </span>
          </div>

          <!-- Link label -->
          <span class="text-[11px] text-charcoal-900/60 group-hover:text-navy-900 transition mt-2">
            Accredited (CSA) &nearr;
          </span>
        </a>

      </div>

    </div>
  </div>
</section>

</BaseLayout>